{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/qwen38",
  "autoupdate": true,
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM",
      "options": {
        "baseURL": "http://10.8.0.6:1122/v1",
        "reasoningEffort": "low"
      },
      "models": {
        "qwen38": {
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (llama-server)",
      "options": {
        "baseURL": "http://10.8.0.9:1122/v1"
      },
      "models": {
        "./models/Ternary-Bonsai-2-27B-PTQ1_0.gguf": {
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "formatter": true,
  "lsp": true
}
